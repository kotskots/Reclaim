@@ -61,6 +61,19 @@
     fun isLockedActive(context: Context): Boolean =
         isActive(context) && strictMode(context).equals("LOCKED", ignoreCase = true)
 
+    /** Locks the currently running session without changing its end time or session id. */
+    fun lockCurrent(context: Context): Boolean {
+        if (!isActive(context)) return false
+        val now = System.currentTimeMillis()
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit()
+            .putString(STRICT_MODE, "LOCKED")
+            .putLong(UPDATED_AT, now)
+            .apply()
+        LockdownPolicy.engage(context)
+        return true
+    }
+
     fun stop(
         context: Context,
         updatedAt: Long = System.currentTimeMillis(),
